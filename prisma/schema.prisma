// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pokemon {
  id           Int      @id @default(autoincrement())
  pokedexId    Int
  pokeApiId    Int      @unique
  name         String
  japaneseName String?
  imageUrl     String?
  difImageUrl  String?
  legendary    Boolean @default(false)
  mythical     Boolean @default(false)
  type         String[]
  height       Int
  weight       Int
  isDefault    Boolean  @default(true)
  formDisplayName     String?
  stats        Stats[]
  abilities    PokemonAbility[]
  description  String?
}

model Evolution{
  id Int @id @default(autoincrement())
  fromPokedexId Int
  toPokedexId Int
}

model Stats {
  id        Int     @id @default(autoincrement())
  name      String
  value     Int
  pokemonId Int
  pokemon   Pokemon @relation(fields: [pokemonId], references: [id])
}

model Ability{
  pokeApiId Int @id
  name String
  japaneseName String
  description String?

  pokemons PokemonAbility[]
}

model PokemonAbility{
  pokemonId Int
  abilityId Int
  slot Int
  isHidden Boolean

  pokemon Pokemon @relation(fields:[pokemonId],references:[id])
  ability Ability @relation(fields:[abilityId],references:[pokeApiId])
  @@id([pokemonId,abilityId])
}